# STAGING ENVIRONMENT CONFIGURATION
# Copy to .env.staging and fill in values

# Flask Configuration
FLASK_ENV=staging
FLASK_DEBUG=False

# Database
DB_USER=staging
DB_PASSWORD=staging_secure_password_changeme
DB_NAME=mismatch
DATABASE_URL=postgresql://staging:staging_secure_password_changeme@db:5432/mismatch_staging

# JWT
JWT_SECRET_KEY=your_staging_jwt_secret_key_min_32_chars_required

# Redis
REDIS_URL=redis://redis:6379/0

# Email Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_staging_email@gmail.com
MAIL_PASSWORD=your_app_specific_password
MAIL_DEFAULT_SENDER=noreply-staging@mismatch-recruiter.ru

# Sentry Error Tracking
SENTRY_DSN_STAGING=https://your_key@sentry.io/your_project_id

# Grafana
GRAFANA_PASSWORD=grafana_staging_password_changeme

# API Configuration
API_RATE_LIMIT=100/hour

# CORS
CORS_ORIGINS=https://staging.mismatch-recruiter.ru,https://app-staging.mismatch-recruiter.ru

# Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Docker Registry
REGISTRY_USERNAME=your_github_username
REGISTRY_TOKEN=your_github_token
