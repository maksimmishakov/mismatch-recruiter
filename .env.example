# Flask Configuration
FLASK_APP=backend/app.py
FLASK_ENV=production
FLASK_DEBUG=False

# Database Configuration
DATABASE_URL=postgresql://mismatch_user:mismatch_password@db:5432/mismatch_db
POSTGRES_USER=mismatch_user
POSTGRES_PASSWORD=mismatch_password
POSTGRES_DB=mismatch_db

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# NLP Configuration
NLP_MODEL_PATH=/app/models
NLP_MODEL_NAME=distilbert-base-uncased-finetuned-sst-2-english
NLP_MAX_TOKENS=512

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000
API_DEBUG=False

# Frontend Configuration
NODE_ENV=production
REACT_APP_API_URL=http://api:5000
REACT_APP_WS_URL=ws://api:5000/ws

# Amvera Deployment
AMVERA_REGISTRY=am.registry.cloud
DOCKER_IMAGE_TAG=latest
DEPLOYMENT_ENVIRONMENT=production

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,https://yourdomain.com
SECURE_COOKIES=True
HTTPS_ONLY=True

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/app/app.log

# Feature Flags
ENABLE_WEBSOCKET=True
ENABLE_NLP_BIAS_DETECTION=True
ENABLE_AUTONOMOUS_AGENTS=True
