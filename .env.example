# MisMatch Recruiter - Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to git!

# ============================================================
# Flask / Application
# ============================================================
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-super-secret-key-change-this-in-production
PORT=5000
BACKEND_PORT=5000

# ============================================================
# Database
# ============================================================
# SQLite (default, no setup required):
DATABASE_URL=sqlite:////tmp/mismatch.db

# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/mismatch_db

# ============================================================
# AI / LLM
# ============================================================
# OpenAI (for GPT-4o-mini interview questions):
OPENAI_API_KEY=sk-your-openai-key-here
LLM_MODEL=gpt-4o-mini

# YandexGPT (optional alternative):
YANDEX_API_KEY=your-yandex-api-key
YANDEX_FOLDER_ID=your-yandex-folder-id

# OpenRouter (optional alternative):
OPENROUTER_API_KEY=your-openrouter-key

# ============================================================
# Telegram Bot (optional)
# ============================================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ADMIN_CHAT_ID=your-chat-id

# ============================================================
# Redis (optional, for caching)
# ============================================================
# REDIS_URL=redis://localhost:6379/0

# ============================================================
# JWT Auth
# ============================================================
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_EXPIRATION_HOURS=24

# ============================================================
# MisMatch Integration (Phase 5)
# ============================================================
MISMATCH_API_KEY=your-mismatch-api-key
MISMATCH_API_URL=https://api.mismatch.io
MISMATCH_HMAC_SECRET=your-hmac-secret

# ============================================================
# Deployment
# ============================================================
# Amvera / Docker port (must match Dockerfile EXPOSE and amvera.yaml)
APP_PORT=5000
