# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=0
FLASK_APP=wsgi:app

# Database Configuration
DATABASE_URL=sqlite:///mismatch.db

# Security
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# CORS Configuration
CORS_ORIGINS=*

# Logging
LOG_LEVEL=INFO

# Server
PORT=5000
WORKERS=4
TIMEOUT=60
