# Application Configuration
FLASK_APP=backend/wsgi.py
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=your-secret-key-change-this-in-production

# Database Configuration
DATABASE_URL=postgresql://recruiter:recruiter_password@db:5432/mismatch_db
SQLALCHEMY_DATABASE_URI=postgresql://recruiter:recruiter_password@db:5432/mismatch_db

# Redis Configuration
REDIS_URL=redis://redis:6379/0
CACHE_REDIS_URL=redis://redis:6379/1

# API Configuration
API_VERSION=1.0.0
MAX_CONTENT_LENGTH=16777216

# Security
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# CORS
CORS_ORIGINS=*

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/mismatch/app.log

# External Services
HH_API_URL=https://hh.ru/api/v2
GITHUB_TOKEN=your-github-token

# Email Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password

