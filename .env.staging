# MisMatch Recruiter - Staging Environment Configuration
# Last Updated: January 9, 2026

# Application Settings
APP_ENV=staging
FLASK_ENV=staging
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration (Staging)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/mismatch_staging
SQLALCHEMY_ECHO=False
SQLALCHEMY_TRACK_MODIFICATIONS=False

# Redis Configuration (Staging)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-staging
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# API Configuration
API_BASE_URL=https://staging-api.mismatch-recruiter.com
FRONTEND_URL=https://staging.mismatch-recruiter.com

# Lamoda Integration (Staging)
LAMODA_CLIENT_ID=staging-client-id
LAMODA_CLIENT_SECRET=staging-client-secret
LAMODA_API_BASE=https://staging-api.lamoda.com
LAMODA_REDIRECT_URI=https://staging-api.mismatch-recruiter.com/auth/lamoda/callback

# Email Configuration (Staging)
MAIL_SERVER=smtp.staging.example.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=staging@example.com
MAIL_PASSWORD=staging-password
MAIL_DEFAULT_SENDER=noreply@staging.mismatch-recruiter.com

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=/var/log/mismatch/app.log

# Monitoring (Staging)
PROMETHEUS_ENABLED=True
GRAFANA_URL=https://grafana-staging.internal

# SSL/TLS Configuration (Staging)
SSL_ENABLED=True
SSL_CERT_PATH=/etc/ssl/certs/staging-cert.pem
SSL_KEY_PATH=/etc/ssl/private/staging-key.pem

# Performance Settings
WORKER_CLASS=sync
WORKER_PROCESSES=2
THREAD_PER_WORKER=2
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=100

# Cache Configuration
CACHE_TYPE=redis
CACHE_DEFAULT_TIMEOUT=300
CACHE_KEY_PREFIX=staging_

# Feature Flags (Staging)
ENABLE_BETA_FEATURES=True
ENABLE_ANALYTICS=True
ENABLE_NOTIFICATIONS=True

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_TIME_LIMIT=300

# Security Settings
CORS_ORIGINS=staging.mismatch-recruiter.com,localhost:3000
CSRF_ENABLED=True
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Backup Configuration
BACKUP_ENABLED=True
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=7
