{
  "dashboard": {
    "title": "MisMatch Recruiter - System Monitoring",
    "timezone": "UTC",
    "refresh": "10s",
    "panels": [
      {
        "title": "API Response Time (p95)",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(flask_http_request_duration_seconds_bucket[5m]))"
          }
        ],
        "type": "graph",
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}
      },
      {
        "title": "Request Rate",
        "targets": [
          {
            "expr": "rate(flask_http_requests_total[5m])"
          }
        ],
        "type": "graph",
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}
      },
      {
        "title": "Error Rate",
        "targets": [
          {
            "expr": "rate(flask_http_requests_total{status=~'5..'}[5m])"
          }
        ],
        "type": "graph",
        "gridPos": {"x": 0, "y": 8, "w": 8, "h": 8}
      },
      {
        "title": "Cache Hit Rate",
        "targets": [
          {
            "expr": "rate(cache_hits_total[5m]) / (rate(cache_hits_total[5m]) + rate(cache_misses_total[5m]))"
          }
        ],
        "type": "graph",
        "gridPos": {"x": 8, "y": 8, "w": 8, "h": 8}
      },
      {
        "title": "Database Connections",
        "targets": [
          {
            "expr": "database_connection_pool_checked_out"
          }
        ],
        "type": "graph",
        "gridPos": {"x": 16, "y": 8, "w": 8, "h": 8}
      },
      {
        "title": "Active Candidates",
        "targets": [
          {
            "expr": "candidates_created_total"
          }
        ],
        "type": "stat",
        "gridPos": {"x": 0, "y": 16, "w": 6, "h": 6}
      },
      {
        "title": "Active Matches",
        "targets": [
          {
            "expr": "matches_found_total"
          }
        ],
        "type": "stat",
        "gridPos": {"x": 6, "y": 16, "w": 6, "h": 6}
      },
      {
        "title": "API Uptime",
        "targets": [
          {
            "expr": "up{job='flask-app'}"
          }
        ],
        "type": "stat",
        "gridPos": {"x": 12, "y": 16, "w": 6, "h": 6}
      },
      {
        "title": "Memory Usage",
        "targets": [
          {
            "expr": "process_resident_memory_bytes / 1024 / 1024"
          }
        ],
        "type": "stat",
        "gridPos": {"x": 18, "y": 16, "w": 6, "h": 6}
      }
    ]
  }
}
