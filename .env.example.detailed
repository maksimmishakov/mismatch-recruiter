# ============================================
# MisMatch Recruiter - Environment Variables
# ============================================
# Copy this file to .env and fill in your local values
# NEVER commit .env with real values to git
# Use .env.example for template only

# ============================================
# FLASK CONFIGURATION
# ============================================
FLASK_ENV=development              # development, testing, production
FLASK_DEBUG=False                  # Set to True only in development
FLASK_APP=app.py

# ============================================
# DATABASE CONFIGURATION
# ============================================
# SQLite (development)
DATABASE_URL=sqlite:///mismatch.db

# PostgreSQL (production - example)
# DATABASE_URL=postgresql://user:password@localhost:5432/mismatch
# DATABASE_URL=postgresql://user:password@prod-db.example.com:5432/mismatch

# ============================================
# SECURITY & AUTHENTICATION
# ============================================
# JWT Secret Key (minimum 32 characters)
# Generate secure key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-min-32-characters
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=30

# CORS Configuration (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Cookies & HTTPS
SECURE_COOKIES=False               # Set to True in production
HTTPS_ONLY=False                   # Set to True in production

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=DEBUG                    # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=/var/log/app/app.log      # Development: logs/app.log
LOG_MAX_SIZE=10485760              # 10MB in bytes
LOG_BACKUP_COUNT=10                # Number of backup files

# ============================================
# ERROR TRACKING (Sentry)
# ============================================
SENTRY_DSN=                        # Leave empty to disable
# Example: https://key@sentry.io/12345

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_WEBSOCKET=True              # Real-time notifications
ENABLE_NLP_BIAS_DETECTION=True     # Resume bias detection
ENABLE_AUTONOMOUS_AGENTS=False     # AI-powered matching

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS_PER_HOUR=100
RATE_LIMIT_REQUESTS_PER_DAY=500

# ============================================
# CACHING (Redis)
# ============================================
REDIS_URL=redis://localhost:6379/0  # Leave empty to disable caching
# REDIS_URL=redis://user:password@cache.example.com:6379/1

# ============================================
# EMAIL CONFIGURATION
# ============================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@mismatch.ai

# ============================================
# AWS S3 (for resume uploads)
# ============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=mismatch-resumes
AWS_S3_REGION=us-east-1

# ============================================
# THIRD-PARTY INTEGRATIONS
# ============================================
# OpenAI (for interview question generation)
OPENAI_API_KEY=

# Stripe (for payments)
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================
# DEVELOPMENT ONLY
# ============================================
SQLALCHEMY_ECHO=False              # Log all SQL queries
SQLALCHEMY_TRACK_MODIFICATIONS=False
TESTING=False                      # Set to True in test environment

